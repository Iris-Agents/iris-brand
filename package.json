{
  "name": "iris-brand",
  "version": "1.3.0",
  "description": "El sistema de marca de iris: design tokens DTCG 2025.10, el CSS ya generado, las fuentes, el logo y el manual.",
  "private": false,
  "type": "module",
  "license": "MIT",
  "exports": {
    "./tokens.css": "./dist/tokens.css",
    "./tailwind.css": "./css/tailwind.css",
    "./fonts.css": "./css/fonts.css",
    "./glass.css": "./css/glass.css",
    "./signature.css": "./css/signature.css",
    "./design-system.json": "./dist/design-system.json",
    "./logo/*": "./logo/*",
    "./fonts/*": "./fonts/*",
    "./pieces/*": "./pieces/*"
  },
  "files": [
    "dist",
    "css",
    "fonts",
    "logo",
    "pieces",
    "tokens"
  ],
  "scripts": {
    "build": "tz build && node scripts/design-system.mjs && node scripts/design-system-claude.mjs && pnpm test",
    "test": "node --test test/*.test.mjs"
  },
  "devDependencies": {
    "@terrazzo/cli": "2.7.1",
    "@terrazzo/parser": "2.7.1",
    "@terrazzo/plugin-css": "2.7.1",
    "colorjs.io": "0.7.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Iris-Agents/iris-brand.git"
  },
  "homepage": "https://github.com/Iris-Agents/iris-brand#readme"
}
